{
  "name": "cobre-server",
  "version": "0.4.0-beta.2",
  "private": true,
  "description": "Aplicativo desktop do Cobre Server para identidade, dispositivos, presença e diagnóstico do ecossistema Cobre.",
  "author": "Bruno C S Moraes (com contribuições de dilucas00)",
  "engines": { "node": ">=22.13" },
  "main": "electron-main.js",
  "scripts": { "start": "node server.js", "app": "electron .", "dist:win": "electron-builder --win nsis zip --publish never", "test": "node --test test/server.test.js" },
  "devDependencies": { "electron": "^45.0.0", "electron-builder": "^26.0.0" },
  "overrides": { "minimatch": "^11.0.9" },
  "build": {
    "appId": "app.cobre.server",
    "productName": "Cobre Server",
    "directories": { "output": "release" },
    "files": ["server.js", "dashboard.js", "dashboard/**/*", "electron-main.js", "preload.js", "package.json"],
    "win": { "icon": "icon.ico", "target": ["nsis", "zip"], "artifactName": "Cobre-Server-${version}-Windows-${arch}.${ext}" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "createStartMenuShortcut": true }
  }
}
